<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🌐 Мой P2P Мессенджер (GitHub Pages)</title>
<script src="https://unpkg.com"></script>
<style>
  body { margin: 0; font-family: system-ui, sans-serif; background: #090d16; color: #f8fafc; display: flex; flex-direction: column; height: 100vh; }
  .top { background: #1e293b; padding: 12px; border-bottom: 1px solid #334155; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  input { background: #0f172a; border: 1px solid #475569; color: #fff; padding: 8px 12px; border-radius: 8px; }
  button { background: #3b82f6; color: #fff; border: none; padding: 8px 14px; border-radius: 8px; font-weight: bold; cursor: pointer; }
  #feed { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 8px; }
  .msg { background: #1e293b; padding: 10px 14px; border-radius: 12px; max-width: 80%; }
  .send-box { background: #1e293b; padding: 10px; display: flex; gap: 8px; }
</style>
</head>
<body>
  <div class="top">
    <span>Твой ID: <b id="my-id" style="color:#38bdf8;">...</b></span>
    <input id="peer-id" placeholder="ID друга">
    <button onclick="connectPeer()">🔗 Подключиться</button>
  </div>
  <div id="feed"></div>
  <div class="send-box">
    <input id="txt" style="flex:1" placeholder="Напиши сообщение..." onkeydown="if(event.key==='Enter')send()">
    <button style="background:#10b981" onclick="send()">➤</button>
  </div>

<script>
  const peer = new Peer();
  let conn = null;

  peer.on('open', id => { document.getElementById('my-id').textContent = id; });
  peer.on('connection', c => { conn = c; setupConn(); addMsg('Система', '🟢 Друг подключился напрямую!'); });

  function connectPeer() {
    const id = document.getElementById('peer-id').value.trim();
    if (!id) return;
    conn = peer.connect(id);
    setupConn();
  }

  function setupConn() {
    conn.on('open', () => addMsg('Система', '✅ Прямое P2P-соединение установлено!'));
    conn.on('data', data => addMsg('Друг', data));
  }

  function send() {
    const inp = document.getElementById('txt');
    if (!inp.value.trim() || !conn) return;
    conn.send(inp.value);
    addMsg('Ты', inp.value);
    inp.value = '';
  }

  function addMsg(who, text) {
    const div = document.createElement('div');
    div.className = 'msg';
    div.innerHTML = `<small style="color:#94a3b8">${who}</small><br>${text.replace(/</g,'&lt;')}`;
    const feed = document.getElementById('feed');
    feed.appendChild(div);
    feed.scrollTop = feed.scrollHeight;
  }
</script>
</body>
</html>
